# Copy to .env and fill in. Never commit .env.

# Token for `claude -p` (from `claude setup-token`). Needed for AI reviews.
CLAUDE_KEY=

# JSON API keys, comma-separated, "name:key". The name shows in the audit trail.
# Make keys long and random, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Leave empty to turn the API off.
DESK_API_KEYS=crm:change-me-to-a-long-random-key

# Where to POST events, comma-separated. Leave empty for no webhooks.
DESK_WEBHOOK_URLS=
# Signs every webhook (HMAC-SHA256). Required when DESK_WEBHOOK_URLS is set.
DESK_WEBHOOK_SECRET=

# This app's public address, used for links inside webhook events.
DESK_PUBLIC_URL=http://127.0.0.1:8000

# Largest .docx accepted, in MB.
DESK_MAX_UPLOAD_MB=10
